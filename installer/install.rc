#include <windows.h>

/* Application icon (shown in Explorer and the title bar). */
1 ICON "icon.ico"

/* Embed the manifest so the installer asks for admin + gets themed dialogs.
   1 == CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 == RT_MANIFEST. */
1 24 "install.manifest"

/* Version information. */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Jedi of Freedom"
            VALUE "FileDescription",  "JoF (EternalJK) Installer"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "install"
            VALUE "OriginalFilename", "install.exe"
            VALUE "ProductName",      "JoF EternalJK Installer"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
